      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2105,
      "endIndex": 2300,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "When you are spending most of your day indoors, often under harsh AC or dealing with a stressful commute, your fabric choice dictates your mood. Here is why we strictly stick to natural comfort.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00019",
      "path": "tabs.t.0.body.content[19]",
      "tabId": "t.0",
