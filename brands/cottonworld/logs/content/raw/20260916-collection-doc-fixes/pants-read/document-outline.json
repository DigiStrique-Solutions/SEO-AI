      "paragraphId": "P00082",
      "path": "tabs.t.0.body.content[82]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5819,
      "endIndex": 5858,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "4. Will my pants shrink after washing?",
      "protectedControls": []
    },
    {
      "paragraphId": "P00083",
      "path": "tabs.t.0.body.content[83]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5858,
      "endIndex": 6080,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Because we use high-quality natural fibers, there might be very minimal shrinkage after the very first wash. Just follow the care labelâ€”wash cold and never use a hot tumble dryerâ€”and they will hold their shape nicely.",
      "protectedControls": []
    },
