      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. 100% Breathable Cotton",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2422,
      "endIndex": 2698,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Forget synthetic blends that make you sweat before you even leave the house. Pure cotton breathes naturally, allowing air to circulate around your torso. It absorbs moisture and softens up beautifully with every single wash, meaning your shirt actually gets better over time.",
      "protectedControls": []
    },
