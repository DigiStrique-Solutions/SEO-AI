      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00054",
      "path": "tabs.t.0.body.content[54]",
