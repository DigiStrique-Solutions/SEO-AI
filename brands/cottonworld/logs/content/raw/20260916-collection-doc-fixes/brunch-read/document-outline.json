      "table": null,
      "text": "2. The Linen Aesthetic",
      "protectedControls": []
    },
    {
      "paragraphId": "P00024",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2638,
      "endIndex": 2906,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Linen is honestly the king of daytime style. Yes, it wrinkles slightly as you wear itâ€”but that is actually the beauty of the fabric! Those soft, natural creases give off a highly sought-after, premium vacation vibe that works perfectly for a relaxed weekend meetup.",
      "protectedControls": []
