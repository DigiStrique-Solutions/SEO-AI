      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1397,
      "endIndex": 1614,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Breathable Cotton T-Shirts: You can never have too many good tees. Made from premium organic cotton and bamboo blends, our [Men's T-Shirts](https://cottonworld.net/collections/mens-tshirts) feel ridiculously soft against your skin and hold their shape wash after wash.",
      "protectedControls": []
    },
    {
