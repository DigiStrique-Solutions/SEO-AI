      "endIndex": 2778,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "For our tailored and slim-fit styles, we weave a tiny bit of premium elastane into the cotton. This gives the fabric a subtle, resilient four-way stretch. You can bend, sit, and move freely without feeling like the seams are going to burst.",
      "protectedControls": []
    },
