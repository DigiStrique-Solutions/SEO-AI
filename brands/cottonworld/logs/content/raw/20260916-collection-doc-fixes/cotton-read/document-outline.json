      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Because pure cotton is completely natural, it doesn't irritate the skin or cause synthetic friction. It is exceptionally gentle, making it the best choice for guys with sensitive skin or those living in warm, humid climates.",
      "protectedControls": []
    },
