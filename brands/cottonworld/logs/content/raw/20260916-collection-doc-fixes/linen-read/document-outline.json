    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[46]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4166,
      "endIndex": 4399,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "This is the easiest style hack out there. Grab a fitted white [Men's T-Shirt](https://cottonworld.net/collections/mens-tshirts) and wear an unbuttoned, brightly colored linen shirt right over it like a very thin, breezy jacket. It adds awesome texture and dimension to a basic outfit.",
      "protectedControls": []
    },
    {
