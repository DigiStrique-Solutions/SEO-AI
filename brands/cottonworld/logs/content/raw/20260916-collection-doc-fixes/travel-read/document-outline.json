    {
      "paragraphId": "P00044",
      "path": "tabs.t.0.body.content[44]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4145,
      "endIndex": 4252,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "You don't always have access to a washing machine when you travel. Here is how to keep your clothes fresh.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00045",
