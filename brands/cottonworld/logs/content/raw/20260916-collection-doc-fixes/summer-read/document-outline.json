    {
      "paragraphId": "P00009",
      "path": "tabs.t.0.body.content[9]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1098,
      "endIndex": 1246,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Building a heat-proof wardrobe is all about picking versatile, lightweight pieces. Here is exactly what you need to survive and thrive this summer.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00010",
      "path": "tabs.t.0.body.content[10]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1246,
      "endIndex": 1247,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1247,
      "endIndex": 1520,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Breezy Linen Shirts: This is the ultimate summer flex. A beautifully textured [Men's Linen Shirt](https://cottonworld.net/collections/mens-linen-shirts) is basically mandatory for the season. They are incredibly airy, dry out in minutes, and give off that premium, relaxed resort vibe whether you are at the beach or in the city.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1520,
      "endIndex": 1761,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Essential Summer Shorts: Ditch the heavy cargo shorts. Our tailored, flat-front [Men's Shorts](https://cottonworld.net/collections/mens-shorts) are cut perfectly above the knee. Crafted from breathable cotton and linen, they keep the air flowing while making you look instantly put-together.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1761,
      "endIndex": 1999,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Lightweight Cotton Pants: Don't want to wear shorts? You don't have to suffer in heavy denim. Our lightweight Men's Pants and linen trousers pull heat right off your legs. They are the perfect hack for looking smart on a blazing hot day.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1999,
      "endIndex": 2217,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Premium Half-Sleeve Shirts: When a full sleeve is just too much, our casual short-sleeve [Men's Shirts](https://cottonworld.net/collections/mens-shirts) step in. They sit cleanly on the bicep without flaring out, offering maximum airflow with a sharp, collared finish.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00015",
      "path": "tabs.t.0.body.content[15]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2217,
      "endIndex": 2434,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Perfect T-Shirts & Polos: For your absolute casual days, grab our ultra-soft [Men's T-Shirts](https://cottonworld.net/collections/mens-tshirts) or our structured Men's Polos. Made with moisture-wicking bamboo and pure organic cotton, they stop sweat in its tracks.",
      "protectedControls": []
    },
    {
