      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Non-Negotiables: Crisp White, Navy Blue, and Black. If your closet doesn't have a perfectly fitting white cotton or linen shirt, start there. It is the single most versatile piece of clothing a man can own.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00031",
      "path": "tabs.t.0.body.content[31]",
      "tabId": "t.0",
