      "text": "Vacation Ready",
      "protectedControls": []
    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[46]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4436,
      "endIndex": 4620,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Grab a brightly colored or pastel Men's Linen Shirt. Pair it with some breathable cotton [Men's Shorts](https://cottonworld.net/collections/mens-shorts). Roll up the sleeves, leave the top two buttons undone, and grab your sunglasses.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00047",
      "path": "tabs.t.0.body.content[47]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4620,
      "endIndex": 4621,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00048",
      "path": "tabs.t.0.body.content[48]",
