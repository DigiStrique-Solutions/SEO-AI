      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Subtle Prints & Stripes: Break up the solids with a fine vertical stripe or a minimalist micro-print shirt. It adds visual interest to your outfit without crossing the line into casual weekend wear.",
