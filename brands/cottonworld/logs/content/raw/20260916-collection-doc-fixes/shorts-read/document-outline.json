      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Whether you are packing for a beach vacation, dealing with a humid city commute, or just lounging on the weekend, we have a silhouette built for the occasion.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00010",
