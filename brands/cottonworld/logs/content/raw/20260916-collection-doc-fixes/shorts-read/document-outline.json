      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "For our tailored chino shorts, we weave in just a tiny fraction of premium elastane. This gives the cotton a resilient, comfortable stretch. You can sit, squat, and move around all day without feeling like the fabric is digging into your thighs.",
      "protectedControls": []
    },
