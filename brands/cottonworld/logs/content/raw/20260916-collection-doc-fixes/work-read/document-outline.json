      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2. A Touch of Elastane",
      "protectedControls": []
    },
    {
      "paragraphId": "P00024",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2619,
      "endIndex": 2917,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Sitting at a desk for hours in rigid trousers is miserable. For our tailored work chinos and slim-fit pants, we weave a tiny bit of premium elastane into the cotton. This gives the fabric a resilient four-way stretch. You can sit, stand, and move freely without the fabric digging into your waist.",
      "protectedControls": []
    },
