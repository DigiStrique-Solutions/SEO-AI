      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 433,
      "endIndex": 858,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "We believe that professional clothing shouldn't feel like a uniform you can't wait to take off. Our collection of men's work clothes is built around premium natural fabrics, clean tailoring, and all-day comfort. Using 100% breathable cotton, structured weaves, and smart stretch blends, we have created an office wardrobe that keeps you looking completely polished while feeling as comfortable as your favorite weekend wear.",
      "protectedControls": []
    },
