    {
      "paragraphId": "P00003",
      "path": "tabs.t.0.body.content[3]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 71,
      "endIndex": 513,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Let's be completely honest. Dressing well during the summer is a massive challenge for most guys. When the temperature spikes and the humidity kicks in, your first instinct is probably to grab the oldest, thinnest athletic shirt you own just to survive the heat. But looking sloppy doesn't have to be the trade-off for staying cool. You can actually beat the heat and look incredibly sharp at the same time you just need the right materials.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00004",
      "path": "tabs.t.0.body.content[4]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 513,
      "endIndex": 514,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 514,
      "endIndex": 1052,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "At Cottonworld, we practically live for summer dressing. We believe that your warm-weather wardrobe should feel completely weightless, highly breathable, and effortlessly stylish. We completely reject synthetic fabrics that trap sweat. Instead, our men's summer collection is engineered entirely from premium natural fibers think 100% pure linen, ultra-lightweight cotton, and breezy bamboo blends. These fabrics act like natural air conditioning, keeping you fresh from your morning coffee run all the way to those late summer evenings.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00006",
      "path": "tabs.t.0.body.content[6]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
