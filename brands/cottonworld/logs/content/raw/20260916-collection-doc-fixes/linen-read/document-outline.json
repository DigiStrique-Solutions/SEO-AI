      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2907,
      "endIndex": 3138,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Absolute Classics: Crisp White and Natural Beige. You literally cannot go wrong here. A white linen shirt is the single most versatile item you can ownâ€”it goes with absolutely every pair of shorts or trousers in your closet.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00032",
      "path": "tabs.t.0.body.content[32]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3138,
      "endIndex": 3317,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Coastal Brights: Sky Blue, Soft Pink, and Mint Green. These pastel shades reflect the sun and instantly put you in vacation mode. They look fantastic paired with neutral bottoms.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00033",
      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
