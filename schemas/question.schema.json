{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Question Registry",
  "type": "object",
  "required": ["version", "questions"],
  "properties": {
    "version": { "type": "string" },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["question_id", "field_ids", "question", "recommended_option", "options", "allow_custom", "store_scope", "blocking_level", "used_by"],
        "properties": {
          "question_id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
          "field_ids": { "type": "array", "items": { "type": "string" } },
          "question": { "type": "string" },
          "recommended_option": { "type": "string" },
          "options": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "string" } },
          "allow_custom": { "type": "boolean" },
          "store_scope": { "type": "string" },
          "blocking_level": { "type": "string" },
          "used_by": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
