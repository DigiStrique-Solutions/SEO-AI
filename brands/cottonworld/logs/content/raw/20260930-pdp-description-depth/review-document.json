            },
            {
              "startIndex": 175,
              "endIndex": 203,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 175,
                    "endIndex": 203,
                    "textRun": {
                      "content": "Depth compared with Batch 1\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.gwzkcsqtqxbv",
                  "namedStyleType": "HEADING_1",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 203,
              "endIndex": 256,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 203,
                    "endIndex": 256,
                    "textRun": {
                      "content": "Batch 1 benchmark: median 121 words per description.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 256,
              "endIndex": 316,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 256,
                    "endIndex": 316,
                    "textRun": {
                      "content": "Batch 2: 135 descriptions; median 119 words, previously 53.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 316,
              "endIndex": 376,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 316,
                    "endIndex": 376,
                    "textRun": {
                      "content": "Batch 3: 116 descriptions; median 120 words, previously 54.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 376,
              "endIndex": 435,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 376,
                    "endIndex": 435,
                    "textRun": {
                      "content": "Batch 4: 82 descriptions; median 119 words, previously 55.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 435,
              "endIndex": 531,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 435,
                    "endIndex": 531,
                    "textRun": {
                      "content": "Word counts exclude the Product ID line. The expanded descriptions range from 106 to 130 words.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 531,
              "endIndex": 544,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 531,
                    "endIndex": 544,
                    "textRun": {
                      "content": "What changed\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.9y1exp82jbnq",
                  "namedStyleType": "HEADING_1",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 544,
              "endIndex": 833,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 544,
                    "endIndex": 833,
                    "textRun": {
                      "content": "Each description keeps the product introduction, construction paragraph, styling note and Product ID. The copy now gives fuller outfit suggestions, with fabric composition, fit and garment details retained. Product-specific care instructions add useful information from the source export.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 833,
              "endIndex": 1024,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 833,
                    "endIndex": 1024,
                    "textRun": {
                      "content": "The earlier corrections remain: no repeated fabric names or product colours in a description, no consecutive duplicate words, and no identical description bodies across the 333 revised rows.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 1024,
              "endIndex": 1043,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1024,
                    "endIndex": 1043,
                    "textRun": {
                      "content": "Sources and checks\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.21t96zml9hmg",
                  "namedStyleType": "HEADING_1",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 1043,
              "endIndex": 1266,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1043,
                    "endIndex": 1266,
                    "textRun": {
                      "content": "Product facts and care instructions are drawn from the Cottonworld verify product export used in the preceding correction pass. Batch 1 supplies the depth and tone benchmark. Styling combinations are editorial suggestions.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 1266,
              "endIndex": 1533,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1266,
                    "endIndex": 1533,
                    "textRun": {
                      "content": "All 333 saved descriptions were read back and matched against the approved local copy. Product codes, URLs, feedback columns, inactive sections and cell notes were preserved. The existing red Product ID highlight in Batch 3 C22 was retained at its new text position.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 1533,
              "endIndex": 1748,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1533,
                    "endIndex": 1748,
                    "textRun": {
                      "content": "The duplicate-product note on Batch 4 C6 remains: this product also appears in Batch 1 and should only be implemented once. Active status follows the tracker’s active sections; this was not a fresh inventory audit.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 1748,
              "endIndex": 1978,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1748,
                    "endIndex": 1978,
                    "textRun": {
                      "content": "Browser access timed out, so rendered row fit could not be rechecked. Text wrapping and cell formats were verified through the Sheets connector. This is an editorial update, without a new AI-detector or publication certification.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
                  },
                  "spaceBelow": {
                    "magnitude": 6,
                    "unit": "PT"
                  }
                }
              }
            },
            {
              "startIndex": 1978,
              "endIndex": 1979,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 1978,
                    "endIndex": 1979,
                    "textRun": {
                      "content": "\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT"
                }
              }
            }
          ]
