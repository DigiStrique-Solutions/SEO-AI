      "startIndex": 4621,
      "endIndex": 4661,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Finding the Right Fabric for the Season",
      "protectedControls": []
    },
    {
      "paragraphId": "P00049",
      "path": "tabs.t.0.body.content[49]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4661,
      "endIndex": 4662,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00050",
      "path": "tabs.t.0.body.content[50]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4662,
      "endIndex": 4813,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Summer Heat: You absolutely need pure linen or lightweight cotton. These fabrics pull heat away from your body and prevent embarrassing sweat patches.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00051",
      "path": "tabs.t.0.body.content[51]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4813,
      "endIndex": 4962,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Humid Monsoon: Stick to linen or our airy half-sleeve cotton shirts. They dry out incredibly fast if you happen to get caught in a quick shower.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00052",
      "path": "tabs.t.0.body.content[52]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4962,
      "endIndex": 5144,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Winter Months: Our slightly heavier cotton shirts are brilliant for layering. Wear them under a sweater or throw a casual Men's Jacket over them for a structured, layered aesthetic.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00053",
      "path": "tabs.t.0.body.content[53]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
