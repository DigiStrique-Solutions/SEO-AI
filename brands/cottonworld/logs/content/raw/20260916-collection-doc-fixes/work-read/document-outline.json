      "endIndex": 432,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Let's be real. The days of suffering through a 9-to-5 in a stiff, uncomfortable suit are mostly over. The modern office is all about smart-casual style. You need to look sharp enough to command a room, but you also need to survive a long commute and eight hours at a desk without feeling entirely trapped in your clothes. That is exactly where Cottonworld steps in.",
      "protectedControls": []
    },
