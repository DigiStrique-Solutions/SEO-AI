      "text": "3. The Premium Texture",
      "protectedControls": []
    },
    {
      "paragraphId": "P00025",
      "path": "tabs.t.0.body.content[25]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
