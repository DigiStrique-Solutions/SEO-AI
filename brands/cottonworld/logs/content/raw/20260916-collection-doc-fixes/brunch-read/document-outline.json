      "endIndex": 4968,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Take care of your premium Cottonworld pieces, and they will be your go-to weekend gear for years.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00053",
      "path": "tabs.t.0.body.content[53]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
