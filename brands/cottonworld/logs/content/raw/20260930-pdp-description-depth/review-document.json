                  }
                }
              }
            },
            {
              "startIndex": 38,
              "endIndex": 148,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 38,
                    "endIndex": 148,
                    "textRun": {
                      "content": "All 333 active descriptions in Batches 2–4 have been expanded in the existing tracker, starting with Batch 2.\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "namedStyleType": "NORMAL_TEXT",
                  "direction": "LEFT_TO_RIGHT",
                  "spaceAbove": {
                    "unit": "PT"
