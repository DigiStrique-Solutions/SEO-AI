      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5145,
      "endIndex": 5189,
      "namedStyleType": "HEADING_1",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "How to Make Your Cotton & Linen Shirts Last",
      "protectedControls": []
    },
    {
      "paragraphId": "P00055",
      "path": "tabs.t.0.body.content[55]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5189,
