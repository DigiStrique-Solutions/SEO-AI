      "protectedControls": []
    },
    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1141,
      "endIndex": 1374,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Premium Cotton Joggers: The absolute holy grail of travel bottoms. Our [Men's Joggers](https://cottonworld.net/collections/mens-joggers) give you the unrestricted freedom of sweatpants, but they are tailored to look incredibly clean and intentional. No baggy knees, just pure comfort.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1374,
      "endIndex": 1667,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Cotton Bamboo T-Shirts: If you are going to be sitting in a tight space for hours, this is what you want against your skin. Our [Men's T-Shirts](https://cottonworld.net/collections/mens-tshirts) made from bamboo blends are naturally moisture-wicking and incredibly soft. They essentially act like a natural climate control system for your body.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1667,
      "endIndex": 1920,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Stretch Cotton Pants: Need to look a bit more put-together upon arrival? Grab a pair of our classic Men's Pants. We weave a hint of premium elastane into the cotton, giving you a four-way stretch that makes sitting for long periods completely painless.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1920,
      "endIndex": 2147,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Layering Overshirt: Airplanes and train cabins get freezing cold. A slightly heavier casual [Men's Shirt](https://cottonworld.net/collections/mens-shirts) or a lightweight jacket is the perfect travel companion. You can easily take it off when you land in a warmer climate.",
      "protectedControls": []
    },
    {
