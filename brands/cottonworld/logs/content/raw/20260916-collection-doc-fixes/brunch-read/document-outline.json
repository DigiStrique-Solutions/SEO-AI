      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. 100% Breathable Cotton",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2362,
      "endIndex": 2614,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "If you are sitting on a sunny outdoor patio, synthetic fabrics are going to make you sweat immediately. Pure cotton breathes naturally. It allows air to circulate right through the garment, keeping you feeling fresh and cool while you sip your coffee.",
      "protectedControls": []
    },
    {
