    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1062,
      "endIndex": 1343,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Tailored Cotton Shirts: The foundation of your Monday-to-Thursday wardrobe. Our structured [Men's Shirts](https://cottonworld.net/collections/mens-shirts) feature crisp collars and a clean drape. They are tailored to tuck perfectly into your trousers without billowing out at the waist, giving you a sharp, professional silhouette.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1343,
      "endIndex": 1598,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Premium Chinos: The absolute workhorse of the modern office. Our tailored Men's Chinos give you that clean, sophisticated look of a dress pant but feel amazingly soft on the inside. They are the perfect middle ground between overly formal and too casual.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1598,
      "endIndex": 1844,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Smart Polos: For casual Fridays or more relaxed tech-focused offices, a regular tee won't cut it. Step it up with our Men's Polos. The structured collar maintains a professional edge, while the breathable cotton keeps you completely comfortable.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1844,
      "endIndex": 2053,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Structured Cotton Pants: Need something a bit more elevated? Our classic regular-fit Men's Pants are crafted from high-quality cotton that holds its shape beautifully throughout long meetings and travel days.",
      "protectedControls": []
    },
