    {
      "paragraphId": "P00003",
      "path": "tabs.t.0.body.content[3]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 78,
      "endIndex": 435,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Let's be honest. Finding the perfect pair of men's pants is usually a massive struggle. You want something that looks sharp enough for a Monday morning meeting, but still feels incredibly comfortable when you're just sitting at a desk or grabbing dinner. Most standard trousers are stiff, restrictive, and trap heat. At Cottonworld, we decided to fix that.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00004",
      "path": "tabs.t.0.body.content[4]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 435,
