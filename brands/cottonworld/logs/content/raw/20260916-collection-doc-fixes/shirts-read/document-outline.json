    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1200,
      "endIndex": 1460,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Classic Casual Shirts: These are the shirts you will end up wearing five days a week. Our casual Men's Shirts feature a relaxed drape and a comfortable collar. They look just as good buttoned up for a dinner out as they do unbuttoned over a classic white tee.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1460,
      "endIndex": 1722,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Pure Linen Shirts: If you want to look effortlessly stylish while staying completely cool, linen is the answer. Our [Men's Linen Shirts](https://cottonworld.net/search?type=product&q=mens+linen+shirts) bring a natural, slightly textured aesthetic that screams premium vacation wear, even if you are just heading to a local cafe.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1722,
      "endIndex": 1969,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Half-Sleeve Shirts: Perfect for those brutally hot days. We tailor our half-sleeve shirts to sit perfectly on the bicepâ€”not too tight, but definitely not flaring out like a parachute. Pair them with [Men's Shorts](https://cottonworld.net/collections/mens-shorts) for the ultimate summer uniform.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
