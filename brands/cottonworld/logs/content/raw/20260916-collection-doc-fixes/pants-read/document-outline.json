      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 436,
      "endIndex": 806,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Our men's pants are built around one simple idea: you shouldn't have to sacrifice comfort to look good. We use premium natural fabrics like 100% breathable cotton, airy linen, and stretch-cotton blends to create trousers that actually move with you. Whether you need crisp chinos for the office or relaxed linen pants for the weekend, we've got your lower half covered.",
      "protectedControls": []
    },
