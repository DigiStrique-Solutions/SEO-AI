    {
      "paragraphId": "P00045",
      "path": "tabs.t.0.body.content[45]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4323,
      "endIndex": 4562,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Need to look a little sharper? Swap the shorts for our tailored [Men's Chinos](https://cottonworld.net/search?type=product&q=mens+chinos) in navy or olive. Pair them with a tucked-in, light blue [Men's Polo](https://cottonworld.net/collections/mens-polos) and a casual leather belt. It shows respect and effort, but you still look perfectly relaxed.",
      "protectedControls": []
    },
