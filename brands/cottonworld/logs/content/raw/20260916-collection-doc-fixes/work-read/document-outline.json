      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Navigating business casual doesn't have to be complicated. We have curated the absolute essentials you need to build a foolproof rotation for the workweek.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00010",
      "path": "tabs.t.0.body.content[10]",
