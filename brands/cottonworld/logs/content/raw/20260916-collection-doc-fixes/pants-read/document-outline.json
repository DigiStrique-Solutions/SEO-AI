      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2. Inside Out: Turn them inside out before tossing them in the machine. It protects the fabric's surface color.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00056",
      "path": "tabs.t.0.body.content[56]",
