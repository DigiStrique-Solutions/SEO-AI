      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Pastels & Summer Shades: Sky Blue, Soft Pink, and Mint Green. These reflect the sun and look fantastic during the day.",
