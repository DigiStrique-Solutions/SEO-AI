      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Unlike traditional stiff workwear that takes months to break in, our natural fabrics are pre-washed and treated to be incredibly soft the very first time you put them on.",
      "protectedControls": []
    },
