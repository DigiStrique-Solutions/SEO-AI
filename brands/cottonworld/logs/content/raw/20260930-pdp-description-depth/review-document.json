                  }
                }
              }
            },
            {
              "startIndex": 148,
              "endIndex": 175,
              "paragraph": {
                "elements": [
                  {
                    "startIndex": 148,
                    "endIndex": 173,
                    "textRun": {
                      "content": "Updated PDP spreadsheet: ",
                      "textStyle": {}
                    }
                  },
                  {
                    "startIndex": 173,
                    "endIndex": 174,
                    "richLink": {
                      "richLinkId": "kix.4sp4pjt3ar45",
