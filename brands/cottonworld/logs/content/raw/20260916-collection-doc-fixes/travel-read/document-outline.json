      "startIndex": 3260,
      "endIndex": 3289,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Long-Haul Flight Uniform",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3289,
      "endIndex": 3572,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Comfort is your absolute priority here. Throw on a pair of dark [Men's Joggers](https://cottonworld.net/collections/mens-joggers) (they hide accidental coffee spills perfectly) and pair them with a basic, loose-fitting cotton tee. Keep a lightweight Men's Jacket or a soft linen shirt handy for when the cabin AC inevitably cranks up.",
      "protectedControls": []
    },
    {
