    {
      "paragraphId": "P00032",
      "path": "tabs.t.0.body.content[32]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3395,
      "endIndex": 3494,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Summer is the perfect excuse to step out of your dark winter color palette and brighten things up.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00033",
      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3494,
      "endIndex": 3495,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3495,
      "endIndex": 3704,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Heat Reflectors: Crisp White, Beige, and Soft Grey. Dark colors absorb the sun's heat; light colors actively reflect it. A white linen shirt is the absolute smartest thing you can wear on a 90-degree day.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00035",
      "path": "tabs.t.0.body.content[35]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3704,
      "endIndex": 3899,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Coastal Pastels: Sky Blue, Mint Green, and Soft Pink. These shades look incredible under bright sunlight. They add a fun, confident pop of color to your outfit without being overwhelmingly loud.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00036",
      "path": "tabs.t.0.body.content[36]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3899,
      "endIndex": 4052,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Earthy Neutrals: Olive, Khaki, and Rust. If pastels aren't your vibe, earthy tones look amazing paired with bright white sneakers or a simple white tee.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00037",
