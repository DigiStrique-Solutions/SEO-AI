    {
      "paragraphId": "P00033",
      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3222,
      "endIndex": 3471,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Corporate Essentials: Navy Blue, Crisp White, Light Blue, and Charcoal Grey. If you are building an office wardrobe from scratch, start right here. A light blue cotton shirt paired with navy chinos is the undefeated champion of modern workwear.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3471,
      "endIndex": 3676,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Earthy & Modern: Khaki, Olive Green, and Stone. These shades add a touch of modern personality to your work look. Khaki trousers are a mandatory staple that pairs flawlessly with almost any colored shirt.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00035",
      "path": "tabs.t.0.body.content[35]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
