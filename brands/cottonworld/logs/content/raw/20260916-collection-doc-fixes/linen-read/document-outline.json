    {
      "paragraphId": "P00040",
      "path": "tabs.t.0.body.content[40]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3653,
      "endIndex": 3888,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Keep it as breezy as possible. Take a light blue or white linen shirt and pair it with some beige linen [Men's Shorts](https://cottonworld.net/collections/mens-shorts). Roll the shirt sleeves up past your elbows, leave it untucked, and slip into some leather sandals or casual loafers.",
