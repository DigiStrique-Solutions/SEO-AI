    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 535,
      "endIndex": 995,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "At Cottonworld, we think that is completely outdated. We believe that looking sharp should never mean sacrificing your comfort. Our collection of men's shirts is crafted entirely from premium natural fabrics like 100% pure cotton and breathable linen. They are ridiculously soft, light on the skin, and designed to actually move with you. From crisp button-downs for the office to relaxed casual shirts for your days off, we have reimagined everyday menswear.",
      "protectedControls": []
    },
    {
