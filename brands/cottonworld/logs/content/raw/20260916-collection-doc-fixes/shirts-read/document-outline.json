      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Earth & Muted Tones: Olive, Khaki, Rust, and Stone. These shades add instant depth to your outfit and pair incredibly well with tailored [Men's Chinos](https://cottonworld.net/search?type=product&q=mens+chinos).",
      "protectedControls": []
    },
