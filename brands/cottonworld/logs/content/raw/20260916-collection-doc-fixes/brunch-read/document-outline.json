    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 617,
      "endIndex": 1002,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "At Cottonworld, we’ve pretty much perfected the art of relaxed weekend wear. We believe your days off should actually feel like days off. Our men's brunch collection is built entirely around premium natural fabrics like 100% breathable cotton and pure, airy linen. These are clothes designed to let you eat, drink, and hang out for hours without ever feeling restricted or overheated.",
      "protectedControls": []
    },
