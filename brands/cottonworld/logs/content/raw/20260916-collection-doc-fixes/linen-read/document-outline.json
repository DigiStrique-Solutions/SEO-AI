      "endIndex": 3516,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Earthy & Dark Tones: Navy Blue, Olive, and Rust. Perfect for evening drinks or slightly dressier summer events. Navy linen gives you a highly sophisticated look while still keeping you totally cool.",
