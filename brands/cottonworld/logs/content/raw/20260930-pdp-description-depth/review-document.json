                  {
                    "startIndex": 1,
                    "endIndex": 38,
                    "textRun": {
                      "content": "Cottonworld: fuller PDP descriptions\n",
                      "textStyle": {}
                    }
                  }
                ],
                "paragraphStyle": {
                  "headingId": "h.w55b0bd9vd56",
                  "namedStyleType": "TITLE",
                  "direction": "LEFT_TO_RIGHT",
