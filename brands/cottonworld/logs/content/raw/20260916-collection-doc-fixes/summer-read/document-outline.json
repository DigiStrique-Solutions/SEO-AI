    {
      "paragraphId": "P00042",
      "path": "tabs.t.0.body.content[42]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4181,
      "endIndex": 4199,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The City Heatwave",
      "protectedControls": []
    },
    {
      "paragraphId": "P00043",
      "path": "tabs.t.0.body.content[43]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4199,
      "endIndex": 4454,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Navigating the city in the summer requires smart layers. Throw on a basic white [Men's T-Shirt](https://cottonworld.net/collections/mens-tshirts) and layer an unbuttoned pastel Men's Linen Shirt right over it. Pair this with tailored khaki shorts and clean sneakers. It is effortless and highly breathable.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00044",
      "path": "tabs.t.0.body.content[44]",
      "tabId": "t.0",
