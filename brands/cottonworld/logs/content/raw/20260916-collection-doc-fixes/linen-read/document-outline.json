    {
      "paragraphId": "P00009",
      "path": "tabs.t.0.body.content[9]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 850,
      "endIndex": 1013,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Whether you are packing for a coastal getaway, attending a summer wedding, or just trying to survive a hot city commute, we have a linen silhouette built for you.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00010",
      "path": "tabs.t.0.body.content[10]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
