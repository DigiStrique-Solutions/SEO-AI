      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00023",
      "path": "tabs.t.0.body.content[23]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2600,
      "endIndex": 2619,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2. Odor Resistance",
      "protectedControls": []
    },
    {
      "paragraphId": "P00024",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2619,
      "endIndex": 2864,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Here is a massive travel hack: Cotton Bamboo blends possess natural anti-odor properties. Bamboo fibers actively wick moisture away from your skin and dry out quickly, meaning your clothes stay smelling neutral even after a full day of transit.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00025",
      "path": "tabs.t.0.body.content[25]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2864,
