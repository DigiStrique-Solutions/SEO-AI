      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Quick Business Trip",
      "protectedControls": []
    },
    {
      "paragraphId": "P00037",
      "path": "tabs.t.0.body.content[37]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3597,
      "endIndex": 3824,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "If you are landing and going straight to a meeting, skip the joggers. Opt for our stretch-cotton tailored Men's Chinos. Pair them with a structured Men's Polo. It looks like standard business casual, but feels like loungewear.",
      "protectedControls": []
    },
