      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2301,
      "endIndex": 2327,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. 100% Breathable Cotton",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2327,
      "endIndex": 2595,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Synthetic dress shirts and polyester trousers trap heat and create sweat patches. Pure cotton breathes naturally, allowing air to circulate around your body. It absorbs moisture quickly, keeping you looking fresh and collected even during high-pressure presentations.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00022",
      "path": "tabs.t.0.body.content[22]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2595,
      "endIndex": 2596,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
