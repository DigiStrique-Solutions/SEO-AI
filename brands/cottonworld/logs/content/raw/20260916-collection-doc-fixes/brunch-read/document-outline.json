      "path": "tabs.t.0.body.content[35]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3659,
      "endIndex": 3853,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Earthy Neutrals: Olive, Beige, and Khaki. If pastels aren't your thing, stick to these grounded tones. They add a slightly rugged, masculine edge while keeping the overall look entirely casual.",
      "protectedControls": []
    },
