      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2. The Linen Advantage",
      "protectedControls": []
    },
    {
      "paragraphId": "P00024",
      "path": "tabs.t.0.body.content[24]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2292,
      "endIndex": 2513,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Linen is nature's built-in air conditioner. It wicks moisture away from your skin rapidly and dries almost instantly. It has a natural, slightly textured look that adds instant character and sophistication to any outfit.",
      "protectedControls": []
    },
    {
