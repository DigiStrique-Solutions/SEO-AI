    },
    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1206,
      "endIndex": 1478,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Pure Linen Shirts: This is the ultimate brunch flex. Nothing says \"I'm off the clock\" quite like a beautifully textured [Men's Linen Shirt](https://cottonworld.net/search?type=product&q=mens+linen+shirts). They are incredibly lightweight, highly breathable, and have that natural, relaxed drape that looks premium without trying too hard.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1478,
      "endIndex": 1738,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Classic Polo: Not a fan of button-downs on the weekend? Step up your game with our structured [Men's Polos](https://cottonworld.net/search?type=product&q=mens+polo). The collar frames your face nicely, making you look completely put-together, while the soft cotton body feels exactly like your favorite casual tee.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1738,
      "endIndex": 1943,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Tailored Chino Shorts: If the weather is warming up, leave the heavy denim at home. Our [Men's Shorts](https://cottonworld.net/collections/mens-shorts) feature a clean, chino-style finish that looks incredibly sharp when paired with a polo or linen shirt.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1943,
      "endIndex": 2180,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Comfort-Stretch Pants: For cooler mornings or indoor reservations, grab a pair of our classic Men's Pants. We weave a tiny bit of elastane into the cotton, so even after a massive meal, your waistband won't be digging into your stomach.",
      "protectedControls": []
    },
