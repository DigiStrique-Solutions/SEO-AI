      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Unlike polyester and acrylic fabrics, which are essentially plastics that trap heat and moisture against your body, cotton is a natural fiber. Its porous structure allows air to circulate freely around your skin, keeping you cool, dry, and comfortable all day long.",
      "protectedControls": []
    },
