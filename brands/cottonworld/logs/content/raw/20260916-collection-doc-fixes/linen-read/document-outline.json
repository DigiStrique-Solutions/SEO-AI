      "protectedControls": []
    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 375,
      "endIndex": 810,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Linen isn't just a fabric; it's a completely different way to experience warm weather. At Cottonworld, we use 100% pure, premium linen to craft menswear that feels practically weightless. Unlike heavy synthetics that trap your body heat, linen acts like nature's built-in air conditioner. It looks effortlessly sharp, keeps you incredibly cool, and features a natural, relaxed texture that instantly gives off a premium vacation vibe.",
      "protectedControls": []
    },
    {
