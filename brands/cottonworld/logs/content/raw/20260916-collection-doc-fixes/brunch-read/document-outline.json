      "path": "tabs.t.0.body.content[33]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3258,
      "endIndex": 3457,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Daytime Pastels: Soft Pink, Sky Blue, and Mint. These shades absolutely shine during daylight hours. A pastel linen shirt instantly brightens your complexion and looks fantastic in outdoor lighting.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3457,
      "endIndex": 3659,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Crisp Classics: White and Navy Blue. You literally cannot mess this up. A crisp white [Men's Shirt](https://cottonworld.net/collections/mens-shirts) paired with navy chinos is the most reliable, handsome outfit a guy can wear to an afternoon event.",
      "protectedControls": []
    },
    {
