      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4746,
      "endIndex": 4842,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Keep your professional wardrobe looking sharp and vibrant by following these simple care rules.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00053",
      "path": "tabs.t.0.body.content[53]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4842,
