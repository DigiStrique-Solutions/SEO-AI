    },
    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 949,
      "endIndex": 1204,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Men's Chinos: The absolute workhorse of your wardrobe. Our tailored [Men's Chinos](https://cottonworld.net/search?type=product&q=mens+chinos) give you that clean, polished look but feel amazingly soft on the inside. They are perfect for the office, date nights, or anytime you need to step it up a notch from denim.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1204,
      "endIndex": 1399,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Classic Cotton Pants: These are your everyday heroes. Crafted from lightweight, high-quality cotton, our regular-fit Men's Cotton Pants drape perfectly and keep your legs breathing all day long.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1399,
      "endIndex": 1631,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Linen Pants: If you haven't worn pure linen trousers in the summer, you're missing out. They are effortlessly stylish, incredibly airy, and give off that relaxed, vacation-ready vibe even if you're just running errands in the city.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
      "path": "tabs.t.0.body.content[14]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1631,
      "endIndex": 1844,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Drawstring & Jogger Styles: Want the comfort of sweatpants but the look of real trousers? Our drawstring cotton pants and joggers are the ultimate hack for long travel days, casual Fridays, or laid-back weekends.",
      "protectedControls": []
    },
