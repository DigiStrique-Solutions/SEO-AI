      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2892,
      "endIndex": 3100,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Essentials: Khaki, Navy Blue, Black, and Stone. If you're building a wardrobe from scratch, start exactly here. A pair of navy chinos or khaki cotton pants will literally go with anything in your closet.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00034",
      "path": "tabs.t.0.body.content[34]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
