      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Beach or Resort Look",
      "protectedControls": []
    },
    {
      "paragraphId": "P00046",
      "path": "tabs.t.0.body.content[46]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4480,
      "endIndex": 4716,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Keep it as breezy as possible. Grab a pair of pure linen trousers or lightweight [Men's Chinos](https://cottonworld.net/collections/mens-chinos) and roll the hems up slightly. Add a casual short-sleeve button-down, leave it untucked, and finish the look with leather sandals or loafers.",
      "protectedControls": []
    },
    {
