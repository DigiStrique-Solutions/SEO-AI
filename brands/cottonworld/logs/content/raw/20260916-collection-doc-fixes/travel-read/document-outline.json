      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00020",
      "path": "tabs.t.0.body.content[20]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2315,
      "endIndex": 2343,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. Unbeatable Breathability",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2343,
      "endIndex": 2599,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Polyester and synthetic blends are basically plastic. They trap body heat and hold onto sweat, which is a nightmare on a crowded flight. Pure cotton naturally allows air to circulate, keeping you feeling fresh even when you are rushing through a terminal.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00022",
      "path": "tabs.t.0.body.content[22]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2599,
      "endIndex": 2600,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
