      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "How to Make Your Linen Last",
      "protectedControls": []
    },
    {
      "paragraphId": "P00049",
      "path": "tabs.t.0.body.content[49]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4428,
