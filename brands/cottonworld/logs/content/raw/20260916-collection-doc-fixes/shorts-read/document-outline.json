      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "1. 100% Breathable Cotton",
      "protectedControls": []
    },
    {
      "paragraphId": "P00020",
      "path": "tabs.t.0.body.content[20]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2364,
      "endIndex": 2601,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Unlike synthetic fabrics (like polyester) that trap heat and sweat, pure cotton is naturally porous. It allows your skin to actually breathe, absorbing moisture quickly and keeping you fresh even on the stickiest, most humid afternoons.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00021",
      "path": "tabs.t.0.body.content[21]",
      "tabId": "t.0",
