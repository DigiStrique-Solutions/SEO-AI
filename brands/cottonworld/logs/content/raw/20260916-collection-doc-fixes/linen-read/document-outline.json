    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1014,
      "endIndex": 1278,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Premium Linen Shirts: The absolute MVP of your summer wardrobe. A beautifully tailored [Men's Linen Shirt](https://cottonworld.net/search?type=product&q=mens+linen+shirts) is mandatory for the season. Wear it buttoned up for a smart-casual dinner, or leave it completely unbuttoned over a basic tee for an effortless weekend look.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1278,
      "endIndex": 1545,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Breezy Linen Pants: Stop suffering in heavy denim during the summer. Our pure linen trousers and lightweight Men's Pants pull heat right off your legs. They give you the sharp look of a tailored trouser but feel as comfortable and airy as your favorite lounge pants.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1545,
      "endIndex": 1691,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Relaxed Linen Shorts: When the temperature peaks, grab our linen shorts. Cut perfectly above the knee, these [Men's Shorts](https://cottonworld.net/collections/mens-shorts) offer maximum airflow. ",
      "protectedControls": []
    },
    {
      "paragraphId": "P00014",
