      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2195,
      "endIndex": 2314,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "When you are traveling, your clothes go through a lot of stress. Here is why natural materials are the only way to go.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00019",
      "path": "tabs.t.0.body.content[19]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
