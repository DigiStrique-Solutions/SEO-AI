    {
      "paragraphId": "P00011",
      "path": "tabs.t.0.body.content[11]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1132,
      "endIndex": 1417,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Classic Chino Shorts: If you want to look instantly put-together, start right here. Our Men's Shorts in the chino style offer a clean, tailored finish. They bridge the gap perfectly between casual and smart, making them ideal for brunch dates, golf weekends, or casual evening drinks.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00012",
      "path": "tabs.t.0.body.content[12]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1417,
      "endIndex": 1938,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Pure Linen Shorts: Heatwaves don't stand a chance. Linen is nature's ultimate cooling fabric. Our linen shorts give off that highly sought-after relaxed, resort-wear vibe. They are incredibly airy, dry in minutes, and look absolutely brilliant when paired with a matching [Men's Linen Shirts](https://cottonworld.net/search?type=product&q=mens+linen+shirts).\u000b\u000bCasual Cotton Shorts: Your ultimate daily drivers. Made from soft, durable, and highly breathable cotton, these shorts are built for heavy rotation. They drape naturally and get more comfortable every single time you wash them.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00013",
      "path": "tabs.t.0.body.content[13]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 1938,
      "endIndex": 2163,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Drawstring & Lounge Shorts: Want absolute freedom? We added an adjustable drawstring waist to some of our premium cotton shorts. They offer the total comfort of your favorite gym wear but look sharp enough to wear to a cafe.",
      "protectedControls": []
    },
    {
