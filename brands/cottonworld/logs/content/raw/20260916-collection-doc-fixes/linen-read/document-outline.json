      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "If you haven't worn high-quality linen before, you are missing out on the best clothing hack for hot weather. Here is why it completely outperforms everything else.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00017",
      "path": "tabs.t.0.body.content[17]",
