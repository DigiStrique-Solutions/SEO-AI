      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Nailing the smart-casual daytime look is all about mixing tailored fits with relaxed materials. Here is what you need to build the perfect weekend rotation.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00010",
      "path": "tabs.t.0.body.content[10]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
