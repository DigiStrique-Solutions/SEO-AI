    {
      "paragraphId": "P00003",
      "path": "tabs.t.0.body.content[3]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 74,
      "endIndex": 442,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Let's be honest about traveling. Whether you are stuck on a fourteen-hour flight, navigating a crowded train station, or just sitting in a car for a weekend road trip, the actual journey is usually pretty exhausting. The last thing you need is a stiff pair of jeans digging into your waist or a synthetic shirt making you sweat before you even reach your destination.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00004",
      "path": "tabs.t.0.body.content[4]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 442,
      "endIndex": 443,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
    {
      "paragraphId": "P00005",
      "path": "tabs.t.0.body.content[5]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 443,
      "endIndex": 925,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "At Cottonworld, we approach travel clothing entirely differently. We believe that your transit wardrobe should feel as comfortable as your favorite pajamas, but look sharp enough that you can walk straight off a plane and into a nice restaurant without needing to change. By using premium natural fabrics like breathable cotton, ultra-soft bamboo blends, and stretch elastane, we have designed a men's travel collection that actually works with your body while you are on the move.",
      "protectedControls": []
    },
    {
