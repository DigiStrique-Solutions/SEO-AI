      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "The Tropical Escape",
      "protectedControls": []
    },
    {
      "paragraphId": "P00040",
      "path": "tabs.t.0.body.content[40]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 3845,
      "endIndex": 4095,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Heading straight to the beach? Wear your breathable cotton shorts on the plane, and pair them with a relaxed Men's Linen Shirt. Roll the sleeves up. You will stay cool during transit and look instantly ready for vacation the second you step outside.",
      "protectedControls": []
    },
