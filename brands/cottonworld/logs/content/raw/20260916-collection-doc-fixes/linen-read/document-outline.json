    {
      "paragraphId": "P00003",
      "path": "tabs.t.0.body.content[3]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 61,
      "endIndex": 374,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Let's just state a simple fact. Summer dressing can be absolutely miserable if you don't have the right fabrics in your closet. When the heat spikes and the humidity hits, you need clothing that actually works with the weather, not against it. That is exactly where our men's linen collection changes everything.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00004",
      "path": "tabs.t.0.body.content[4]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
