      "endIndex": 5593,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "3. What's the difference between chinos and regular cotton pants?",
      "protectedControls": []
    },
    {
      "paragraphId": "P00080",
      "path": "tabs.t.0.body.content[80]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5593,
      "endIndex": 5818,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Chinos are typically made from a specific twill weave cotton, giving them a slightly dressier, smoother finish. Regular cotton pants might feature different weaves, often feeling a bit more relaxed and casual in their drape.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00081",
      "path": "tabs.t.0.body.content[81]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 5818,
      "endIndex": 5819,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "",
      "protectedControls": []
    },
