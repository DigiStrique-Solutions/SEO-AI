      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Summer Evening Drinks",
      "protectedControls": []
    },
    {
      "paragraphId": "P00049",
      "path": "tabs.t.0.body.content[49]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 4739,
      "endIndex": 4999,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "When the sun goes down but it is still incredibly humid, swap the shorts for dark, lightweight Men's Pants. Tuck in a structured navy or black [Men's Polo](https://cottonworld.net/search?type=product&q=mens+polo). You look sharp and dressed-up for the evening, but the breathable cotton keeps you entirely comfortable.",
      "protectedControls": []
    },
