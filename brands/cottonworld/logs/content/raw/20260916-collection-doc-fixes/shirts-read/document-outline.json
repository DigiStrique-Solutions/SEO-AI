      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Smart-Casual Office Shirts: Need to look professional but hate stiff collars? Our structured cotton shirts offer a clean, tailored silhouette that tucks perfectly into Men's Pants but feels as comfortable as your favorite weekend clothes.",
      "protectedControls": []
    },
