      "protectedControls": []
    },
    {
      "paragraphId": "P00026",
      "path": "tabs.t.0.body.content[26]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2865,
      "endIndex": 2885,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "3. Built-In Stretch",
      "protectedControls": []
    },
    {
      "paragraphId": "P00027",
      "path": "tabs.t.0.body.content[27]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2885,
      "endIndex": 3127,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Nobody wants to sit in a rigid pair of trousers for six hours. The subtle stretch we add to our travel pants and joggers ensures the fabric moves perfectly with you, preventing that awful feeling of your clothes cutting off your circulation.",
      "protectedControls": []
    },
    {
      "paragraphId": "P00028",
      "path": "tabs.t.0.body.content[28]",
