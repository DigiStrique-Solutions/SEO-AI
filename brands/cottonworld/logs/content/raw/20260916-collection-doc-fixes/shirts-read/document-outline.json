      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "This is the easiest way to look stylish. Throw on a basic [Men's T-Shirt](https://cottonworld.net/collections/mens-tshirts) (white or grey works best) and wear an unbuttoned casual cotton shirt over it like a lightweight jacket. Pair it with chinos and sneakers. It adds instant dimension to your outfit.",
      "protectedControls": []
    },
