      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "2. The Magic of Pure Linen",
      "protectedControls": []
    },
    {
      "paragraphId": "P00023",
      "path": "tabs.t.0.body.content[23]",
      "tabId": "t.0",
      "tabTitle": "Tab 1",
      "segmentId": null,
      "startIndex": 2629,
      "endIndex": 2884,
      "namedStyleType": "NORMAL_TEXT",
      "isListItem": false,
      "listId": null,
      "nestingLevel": null,
      "table": null,
      "text": "Linen fibers are hollow, meaning they act like natural thermal regulators. A pure linen short allows maximum airflow, keeping your lower half noticeably cooler than the ambient temperature. It is simply the best fabric you can wear in a tropical climate.",
      "protectedControls": []
    },
    {
